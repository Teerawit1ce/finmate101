{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harn-tao-backend",
  "main": "src/server.ts",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "finmate-db",
      "database_id": "25e0cb2a-e34e-4b56-a113-388929962d52",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "357c245477ef48baaa89d1cf80cef33d"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
